{
  "name": "radwind",
  "version": "0.0.7",
  "license": "MIT",
  "scripts": {
    "build": "bun run build.ts"
  },
  "files": [
    "build",
    "package.json"
  ],
  "exports": {
    "./postcss": {
      "types": "./build/postcss.plugin.d.ts",
      "import": "./build/postcss.plugin.mjs",
      "require": "./build/postcss.plugin.load-config-fix.js"
    },
    "./tailwind": "./build/tailwind.theme.css",
    "./tailwind/plugin": {
      "types": "./build/tailwind.plugin.d.ts",
      "import": "./build/tailwind.plugin.mjs",
      "require": "./build/tailwind.plugin.js"
    },
    "./vite": {
      "types": "./build/vite.plugin.d.ts",
      "import": "./build/vite.plugin.mjs",
      "require": "./build/vite.plugin.js"
    }
  },
  "dependencies": {
    "@radix-ui/colors": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "postcss": "catalog:build",
    "tailwindcss": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:build"
  },
  "peerDependencies": {
    "postcss": "8.x",
    "tailwindcss": "4.x",
    "vite": "6.x"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
